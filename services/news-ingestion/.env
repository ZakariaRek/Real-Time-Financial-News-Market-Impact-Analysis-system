server:
  port: 4001
  environment: development

database:
  # PostgreSQL configuration
  # For production, use AWS RDS PostgreSQL instance
  postgres:
    host: localhost          # For prod: your-rds-endpoint.region.rds.amazonaws.com
    port: 5432
    database: news_ingestion
    username: news_user
    password: news_password
    # AWS RDS specific settings for production
    # ssl_mode: require
    # max_open_conns: 25
    # max_idle_conns: 5
    # conn_max_lifetime: 5m
    # conn_max_idle_time: 1m

redis:
  host: localhost
  port: 6379
  database: 0
  password: ""

logging:
  level: info
  format: json

rate_limiting:
  default_requests_per_minute: 60
  burst_size: 10

news_sources:
  newsapi:
    api_key: "your_newsapi_key"
    base_url: "https://newsapi.org/v2"

  twitter:
    bearer_token: "your_twitter_bearer_token"
    base_url: "https://api.twitter.com/2"

  rss_feeds:
    - name: "Reuters Business"
      url: "https://feeds.reuters.com/reuters/businessNews"
    - name: "Bloomberg Markets"
      url: "https://feeds.bloomberg.com/markets/news.rss"

processing:
  batch_size: 100
  worker_count: 5
  retry_attempts: 3
  timeout_seconds: 30