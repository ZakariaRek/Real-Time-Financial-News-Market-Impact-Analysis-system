# services/news-ingestion/.env.example
# Copy this file to .env and update with your values
# Note: This file is for documentation. Set these in your environment or Kubernetes ConfigMap/Secret

# ========================================
# Server Configuration
# ========================================
SERVER_HTTP_PORT=4001
SERVER_GRPC_PORT=4002
SERVER_ENVIRONMENT=development

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=news_ingestion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yahyasd56

# Database Connection Pool
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m
DATABASE_CONN_MAX_IDLE_TIME=1m

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=info          # Options: debug, info, warn, error
LOG_FORMAT=text         # Options: text, json

# ========================================
# Processing Configuration
# ========================================
ENABLE_AUTO_INGESTION=true
SENTIMENT_TRIGGER_THRESHOLD=10

# Cron Schedules (second minute hour day month weekday)
RSS_SCHEDULE="0 */2 * * * *"        # Every 2 minutes
NEWSAPI_SCHEDULE="0 */7 * * * *"    # Every 7 minutes
CLEANUP_SCHEDULE="0 0 0 * * *"      # Daily at midnight

BATCH_SIZE=100
WORKER_COUNT=5
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30

# ========================================
# News Sources Configuration
# ========================================
# NewsAPI.org - Get your key at https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here
NEWSAPI_BASE_URL=https://newsapi.org/v2
NEWSAPI_ENABLED=true

# Twitter API v2
TWITTER_BEARER_TOKEN=
TWITTER_BASE_URL=https://api.twitter.com/2
TWITTER_ENABLED=false

# ========================================
# External Services
# ========================================
# NLP Processing Service
NLP_SERVICE_ENDPOINT=localhost:50052
NLP_TIMEOUT=30s
NLP_MAX_RETRY=3