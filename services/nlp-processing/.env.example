# =================================================================
# NLP Processing Service - Environment Configuration
# =================================================================
# Copy this file to .env and update with your values
# Example: cp .env.example .env

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nlp_processing
POSTGRES_USER=postgres

# -----------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1

# -----------------------------------------------------------------
# Service Configuration
# -----------------------------------------------------------------
ENVIRONMENT=development
SERVER_PORT=4002
GRPC_PORT=50052
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------
PROCESSING_WORKER_COUNT=3
PROCESSING_BATCH_SIZE=50
PROCESSING_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------
# External Services
# -----------------------------------------------------------------
# News Ingestion Service gRPC endpoint
NEWS_INGESTION_ENDPOINT=localhost:50051
NEWS_INGESTION_TIMEOUT=30s

# -----------------------------------------------------------------
# Optional Tools (PgAdmin, Redis Commander)
# -----------------------------------------------------------------
# Uncomment to enable management tools
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=admin

# -----------------------------------------------------------------
# Production Settings (AWS/Cloud Deployment)
# -----------------------------------------------------------------
# Uncomment and configure for production
# DATABASE_HOST=your-nlp-rds-endpoint.us-east-1.rds.amazonaws.com
# DATABASE_SSL_MODE=require
# DATABASE_MAX_OPEN_CONNS=30
# DATABASE_MAX_IDLE_CONNS=10
# REDIS_HOST=your-elasticache-endpoint.cache.amazonaws.com
# REDIS_TLS_ENABLED=true

# -----------------------------------------------------------------
# Monitoring & Observability (Optional)
# -----------------------------------------------------------------
# JAEGER_ENDPOINT=http://jaeger:14268/api/traces
# PROMETHEUS_PORT=9090
# METRICS_ENABLED=true