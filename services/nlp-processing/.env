# =================================================================
# NLP Processing Service - Environment Configuration
# =================================================================

# -----------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------
SERVER_PORT=4002
ENVIRONMENT=development

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nlp_processing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zakaria

# Production AWS RDS Settings (uncomment for production)
# DATABASE_SSL_MODE=require
# DATABASE_MAX_OPEN_CONNS=30
# DATABASE_MAX_IDLE_CONNS=10
# DATABASE_CONN_MAX_LIFETIME=5m
# DATABASE_CONN_MAX_IDLE_TIME=2m

# -----------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=1
REDIS_PASSWORD=

# -----------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# -----------------------------------------------------------------
# Processing Configuration
# -----------------------------------------------------------------
PROCESSING_WORKER_COUNT=3
PROCESSING_BATCH_SIZE=50
PROCESSING_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT_SECONDS=60
PROCESSING_ENABLE_AUTO_INGESTION=true
PROCESSING_SENTIMENT_TRIGGER_THRESHOLD=10
PROCESSING_RSS_SCHEDULE="0 */2 * * * *"
PROCESSING_NEWSAPI_SCHEDULE="0 */7 * * * *"

# -----------------------------------------------------------------
# gRPC Configuration
# -----------------------------------------------------------------
GRPC_PORT=50052
GRPC_MAX_RECEIVE_MESSAGE_SIZE=4194304
GRPC_MAX_SEND_MESSAGE_SIZE=4194304

# -----------------------------------------------------------------
# External Services
# -----------------------------------------------------------------
NEWS_INGESTION_ENDPOINT=localhost:50051
NEWS_INGESTION_TIMEOUT=30s

# -----------------------------------------------------------------
# Optional Tools (PgAdmin, Redis Commander)
# -----------------------------------------------------------------
# Uncomment to enable management tools
# PGADMIN_EMAIL=admin@example.com
# PGADMIN_PASSWORD=admin