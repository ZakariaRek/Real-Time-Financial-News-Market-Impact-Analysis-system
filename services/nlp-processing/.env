server:
  port: 4002
  environment: development

database:
  # PostgreSQL configuration for NLP Processing Service
  # Note: In the original design, this service uses ClickHouse for analytics
  # But implementing PostgreSQL as requested for consistency
  # For production with high-volume analytics, consider ClickHouse on AWS
  postgres:
    host: localhost          # For prod: your-nlp-rds-endpoint.region.rds.amazonaws.com
    port: 5432
    database: nlp_processing
    username: nlp_user
    password: nlp_password
    # AWS RDS specific settings for production
    # ssl_mode: require
    # max_open_conns: 30
    # max_idle_conns: 10
    # conn_max_lifetime: 5m
    # conn_max_idle_time: 2m

redis:
  host: localhost
  port: 6379
  database: 1
  password: ""

logging:
  level: info
  format: json

models:
  finbert:
    model_path: "./models/finbert/model.bin"
    device: "cpu"  # or "cuda" for GPU
    batch_size: 32
    max_length: 512

  ner:
    model_path: "./models/ner/model.bin"
    spacy_model: "en_core_web_sm"
    confidence_threshold: 0.7

  topic_classifier:
    model_path: "./models/topic/classifier.bin"
    categories:
      - "Market Analysis"
      - "Earnings"
      - "Mergers & Acquisitions"
      - "Economic Indicators"
      - "Regulatory News"
      - "Company News"
      - "Crypto"
      - "Commodities"

processing:
  batch_size: 50
  worker_count: 3
  retry_attempts: 3
  timeout_seconds: 60

grpc:
  port: 50052
  max_receive_message_size: 4194304  # 4MB
  max_send_message_size: 4194304     # 4MB

external_services:
  news_ingestion_service:
    grpc_endpoint: "localhost:50051"
    timeout: "30s"